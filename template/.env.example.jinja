# Environment variables override .env. Keep this file private when copied to .env.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/app.sqlite3
LOG_LEVEL=INFO
{% if enable_jobs %}
REDIS_URL=redis://127.0.0.1:6379/0
SCHEDULE_INTERVAL_SECONDS=300
{% endif %}
{% if enable_ntfy %}
# Optional: uncomment and configure before sending notifications.
# NTFY_URL=https://ntfy.example.com
# NTFY_TOPIC=private-topic
# NTFY_TOKEN=tk_your_access_token
NTFY_TIMEOUT_SECONDS=5
{% endif %}
