class HealthResponse(BaseModel):
    status: str
    dependencies: dict[str, str]


{% if enable_jobs %}
class JobRequest(BaseModel):
    message: str = Field(min_length=1, max_length=2000)


class JobReceipt(BaseModel):
    job_id: str


{% endif %}
@asynccontextmanager
async def lifespan(app: FastAPI):
    await asyncio.to_thread(init_db)
{% if enable_jobs %}
    if not broker.is_worker_process:
        await broker.startup()
    app.state.redis = await new_pool()
    try:
{% if enable_mcp %}
        if broker.is_worker_process:
            yield
        else:
            async with app.state.mcp_app.lifespan(app.state.mcp_app):
                yield
{% else %}
        yield
{% endif %}
    finally:
        await app.state.redis.aclose()
        if not broker.is_worker_process:
            await broker.shutdown()
{% else %}
{% if enable_mcp %}
    async with app.state.mcp_app.lifespan(app.state.mcp_app):
        yield
{% else %}
    yield
{% endif %}
{% endif %}


router = APIRouter()


@router.get("/health/live")
async def liveness() -> dict[str, str]:
    return {"status": "ok"}


@router.get("/health")
@router.get("/health/ready")
async def health(
{% if enable_jobs %}
    request: Request,
{% endif %}
    response: Response,
) -> HealthResponse:
    dependencies = {"sqlite": "ok"}
    try:
        await asyncio.to_thread(check_database)
    except OSError, sqlite3.Error:
        dependencies["sqlite"] = "unavailable"
{% if enable_jobs %}
    try:
        async with asyncio.timeout(2):
            await request.app.state.redis.ping()
        dependencies["redis"] = "ok"
    except OSError, RedisError, TimeoutError:
        dependencies["redis"] = "unavailable"
{% endif %}
    ready = all(value == "ok" for value in dependencies.values())
    response.status_code = status.HTTP_200_OK if ready else status.HTTP_503_SERVICE_UNAVAILABLE
    return HealthResponse(status="ok" if ready else "unavailable", dependencies=dependencies)


@router.get("/messages/count")
async def message_count() -> dict[str, int]:
    return {"count": await asyncio.to_thread(count_messages)}
{% if enable_jobs %}


@router.post("/jobs", response_model=JobReceipt, status_code=status.HTTP_202_ACCEPTED)
async def enqueue_job(payload: JobRequest) -> JobReceipt:
    try:
        async with asyncio.timeout(10):
            job_id = await submit_message(payload.message)
    except (OSError, RedisError, SendTaskError, TimeoutError) as exc:
        raise HTTPException(status_code=503, detail="Job queue unavailable") from exc
    return JobReceipt(job_id=job_id)
{% endif %}


def create_app() -> FastAPI:
    app = FastAPI(title={{ project_name | tojson }}, lifespan=lifespan)
    app.add_middleware(GZipMiddleware, minimum_size=1024, compresslevel=5)
    app.include_router(router)
{% if enable_mcp %}
    server = create_mcp_server()
    mcp_app = server.http_app(
        path="/",
        stateless_http=True,
        json_response=True,
        host_origin_protection=True,
        allowed_hosts=["localhost", "127.0.0.1", "::1"],
        allowed_origins=[],
    )
    app.state.mcp_app = mcp_app
    app.mount("/mcp", mcp_app)
{% endif %}
    return app


app = create_app()
