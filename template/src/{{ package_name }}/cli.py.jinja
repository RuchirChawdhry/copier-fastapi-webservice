"""Thin Cyclopts interface to API, jobs, scheduling and Ubuntu status."""

import subprocess

from cyclopts import App
from rich.console import Console
from rich.table import Table

from .config import get_settings
from .db import count_messages
from .db import init_db as initialize_database
from .logging_config import configure_logging

app = App(name="{{ cli_command }}")
console = Console()


@app.command
def serve(host: str | None = None, port: int | None = None) -> None:
    """Start the FastAPI server (foreground; systemd supervises it)."""
    import uvicorn

    configure_logging()
    settings = get_settings()
    uvicorn.run(
        "{{ package_name }}.api:app",
        host=host or settings.host,
        port=port or settings.port,
        workers=1,
        log_config=None,
    )


{% if enable_jobs %}
@app.command
def worker() -> None:
    """Start the Taskiq worker under its native process supervisor."""
    import os
    import sys

    os.execv(
        sys.executable,
        [
            sys.executable,
            "-m",
            "taskiq",
            "worker",
            "{{ package_name }}.worker:broker",
            "--workers",
            "1",
            "--max-async-tasks",
            "10",
            "--ack-type",
            "when_saved",
            "--no-configure-logging",
        ],
    )


@app.command
def scheduler() -> None:
    """Start the independent periodic job dispatcher."""
    import asyncio
    import signal
    from contextlib import suppress

    from .scheduler import run_scheduler

    async def main() -> None:
        task = asyncio.create_task(run_scheduler())
        asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, task.cancel)
        with suppress(asyncio.CancelledError):
            await task

    configure_logging()
    asyncio.run(main())


{% endif %}
@app.command
def init_db() -> None:
    """Initialize the SQLite database."""
    initialize_database()
    console.print("[green]SQLite initialized[/green]")


{% if enable_jobs %}
@app.command
async def enqueue(message: str) -> None:
    """Submit a message job to Redis."""
    from .jobs import submit_message
    from .queue import broker

    configure_logging()
    await broker.startup()
    try:
        job_id = await submit_message(message)
        console.print(f"[green]Queued[/green] {job_id}")
    finally:
        await broker.shutdown()


{% endif %}
@app.command
def status() -> None:
    """Show local database and systemd service status."""
    table = Table(title="{{ project_name }}")
    table.add_column("Component")
    table.add_column("Status")
    for kind in ({% if enable_jobs %}"api", "worker", "scheduler"{% else %}"api",{% endif %}):
        unit = "{{ project_slug }}-" + kind + ".service"
        try:
            result = subprocess.run(
                ["systemctl", "is-active", unit],
                capture_output=True,
                text=True,
                check=False,
                timeout=5,
            )
            value = result.stdout.strip() or "not installed"
        except OSError, subprocess.TimeoutExpired:
            value = "systemd unavailable"
        table.add_row(kind, value)

    try:
        table.add_row("SQLite messages", str(count_messages()))
    except Exception:
        table.add_row("SQLite messages", "not initialized")
    console.print(table)


@app.command
def resources() -> None:
    """Print machine and CLI process resource usage as JSON."""
    import json

    from .resources import resource_snapshot

    print(json.dumps(resource_snapshot()))


@app.command
def doctor(require_running: bool = False) -> None:
    """Emit a JSON diagnostic report; exit 1 if a required check fails."""
    import json

    from .doctor import diagnose

    report = diagnose(require_running=require_running)
    print(json.dumps(report.model_dump(mode="json")))
    raise SystemExit(1 if report.status == "fail" else 0)
{% if enable_ntfy %}


@app.command
async def notify(
    message: str,
    title: str = "{{ project_name }}",
    priority: int = 3,
) -> None:
    """Publish a push notification to the configured ntfy topic."""
    from .notifications import notify as publish

    message_id = await publish(message, title=title, priority=priority)
    console.print(f"[green]Published[/green] {message_id}")
{% endif %}
