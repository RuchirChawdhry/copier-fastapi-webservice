"""Validated process-local configuration; environment overrides .env."""

from functools import cache
from pathlib import Path
from typing import Literal

{% if enable_ntfy %}
from pydantic import Field, HttpUrl, SecretStr, field_validator
{% else %}
from pydantic import Field, field_validator
{% endif %}
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env", env_file_encoding="utf-8", extra="ignore", frozen=True
    )

    host: str = Field(default="127.0.0.1", validation_alias="APP_HOST")
    port: int = Field(default=8000, ge=1, le=65535, validation_alias="APP_PORT")
    database_path: Path = Path("data/app.sqlite3")
    log_level: Literal["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] = "INFO"
{% if enable_jobs %}
    redis_url: str = "redis://127.0.0.1:6379/0"
    schedule_interval_seconds: int = Field(default=300, ge=1)
{% endif %}

{% if enable_ntfy %}
    ntfy_url: HttpUrl | None = None
    ntfy_topic: str | None = Field(default=None, pattern=r"^[-_A-Za-z0-9]{1,64}$")
    ntfy_token: SecretStr | None = None
    ntfy_timeout_seconds: float = Field(default=5, gt=0, le=60)

{% endif %}
    @field_validator("log_level", mode="before")
    @classmethod
    def normalize_log_level(cls, value: str) -> str:
        return value.upper()


@cache
def get_settings() -> Settings:
    """Load settings once per process."""
    return Settings()
