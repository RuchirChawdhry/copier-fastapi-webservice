"""Background tasks, independent of HTTP requests."""

import asyncio

from loguru import logger

from .db import record_message
from .queue import broker


@broker.task
async def save_message(message: str) -> int:
    message_id = await asyncio.to_thread(record_message, message)
    logger.info("Saved job message id={}", message_id)
    return message_id


async def submit_message(message: str) -> str:
    job = await save_message.kiq(message)
    return job.task_id
