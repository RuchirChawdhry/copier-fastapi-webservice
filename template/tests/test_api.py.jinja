class FakeRedis:
    def __init__(self):
        self.messages = []
        self.closed = False
        self.available = True

    async def ping(self):
        if not self.available:
            raise RedisConnectionError("offline")
        return True

    async def aclose(self):
        self.closed = True


{% endif %}
def test_api_health_and_readiness(monkeypatch):
{% if enable_jobs %}
    redis = FakeRedis()

    async def fake_new_pool():
        return redis

    async def noop():
        pass

    async def submit(message):
        redis.messages.append(message)
        return "fake-job-001"

    monkeypatch.setattr(api, "new_pool", fake_new_pool)
    monkeypatch.setattr(api.broker, "startup", noop)
    monkeypatch.setattr(api.broker, "shutdown", noop)
    monkeypatch.setattr(api, "submit_message", submit)
{% endif %}
    with TestClient(api.app) as client:
        assert client.get("/health/live").json() == {"status": "ok"}
        response = client.get("/health")
        assert response.status_code == 200
        assert response.json()["dependencies"]["sqlite"] == "ok"
        assert client.get("/messages/count").json() == {"count": 0}
{% if not enable_mcp %}
        assert client.post("/mcp/", json={}).status_code == 404
{% endif %}
{% if enable_jobs %}
        assert response.json()["dependencies"]["redis"] == "ok"
        assert client.post("/jobs", json={"message": "hello"}).status_code == 202
        assert client.post("/jobs", json={"message": ""}).status_code == 422
        assert redis.messages == ["hello"]
        redis.available = False
        assert client.get("/health/ready").status_code == 503
        assert client.get("/health/live").status_code == 200
{% else %}
        assert client.post("/jobs", json={"message": "hello"}).status_code == 404
{% endif %}

        def unavailable():
            raise sqlite3.OperationalError("offline")

        monkeypatch.setattr(api, "check_database", unavailable)
        response = client.get("/health/ready")
        assert response.status_code == 503
        assert response.json()["dependencies"]["sqlite"] == "unavailable"
{% if enable_jobs %}
    assert redis.closed
{% endif %}


def test_gzip_negotiation():
    client = TestClient(api.create_app())
    try:
        compressed = client.get("/openapi.json", headers={"Accept-Encoding": "gzip"})
        plain = client.get("/openapi.json", headers={"Accept-Encoding": "identity"})
        assert compressed.headers["content-encoding"] == "gzip"
        assert "accept-encoding" in compressed.headers["vary"].lower()
        assert "content-encoding" not in plain.headers
        assert compressed.json() == plain.json()
        assert int(compressed.headers["content-length"]) < int(plain.headers["content-length"])
        small = client.get("/health/live", headers={"Accept-Encoding": "gzip"})
        assert "content-encoding" not in small.headers
    finally:
        client.close()


def test_gzip_preserves_event_stream():
    from fastapi.responses import StreamingResponse

    application = api.create_app()

    @application.get("/test-stream")
    def stream():
        return StreamingResponse(
            iter(["data: " + "x" * 2048 + "\n\n"]), media_type="text/event-stream"
        )

    client = TestClient(application)
    try:
        response = client.get("/test-stream", headers={"Accept-Encoding": "gzip"})
        assert response.status_code == 200
        assert "content-encoding" not in response.headers
        assert response.text.startswith("data: ")
    finally:
        client.close()
