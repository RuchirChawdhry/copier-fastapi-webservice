import sqlite3

from fastapi.testclient import TestClient
{% if enable_jobs %}
from redis.exceptions import ConnectionError as RedisConnectionError
{% endif %}

from {{ package_name }} import api

{% if enable_jobs %}

class FakeJob:
    job_id = "fake-job-001"


class FakeRedis:
    def __init__(self):
        self.messages = []
        self.closed = False
        self.available = True

    async def ping(self):
        if not self.available:
            raise RedisConnectionError("offline")
        return True

    async def enqueue_job(self, name: str, message: str):
        self.messages.append((name, message))
        return FakeJob()

    async def aclose(self):
        self.closed = True


{% endif %}
def test_api_health_and_readiness(monkeypatch):
{% if enable_jobs %}
    redis = FakeRedis()

    async def fake_new_pool():
        return redis

    monkeypatch.setattr(api, "new_pool", fake_new_pool)
{% endif %}
    with TestClient(api.app) as client:
        assert client.get("/health/live").json() == {"status": "ok"}
        response = client.get("/health")
        assert response.status_code == 200
        assert response.json()["dependencies"]["sqlite"] == "ok"
        assert client.get("/messages/count").json() == {"count": 0}
{% if enable_jobs %}
        assert response.json()["dependencies"]["redis"] == "ok"
        assert client.post("/jobs", json={"message": "hello"}).status_code == 202
        assert client.post("/jobs", json={"message": ""}).status_code == 422
        assert redis.messages == [("save_message", "hello")]
        redis.available = False
        assert client.get("/health/ready").status_code == 503
        assert client.get("/health/live").status_code == 200
{% else %}
        assert client.post("/jobs", json={"message": "hello"}).status_code == 404
{% endif %}

        def unavailable():
            raise sqlite3.OperationalError("offline")

        monkeypatch.setattr(api, "check_database", unavailable)
        response = client.get("/health/ready")
        assert response.status_code == 503
        assert response.json()["dependencies"]["sqlite"] == "unavailable"
{% if enable_jobs %}
    assert redis.closed
{% endif %}
