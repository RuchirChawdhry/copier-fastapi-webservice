from fastapi.testclient import TestClient

from {{ package_name }} import api


class FakeJob:
    job_id = "fake-job-001"


class FakeRedis:
    def __init__(self):
        self.messages = []
        self.closed = False

    async def enqueue_job(self, name: str, message: str):
        self.messages.append((name, message))
        return FakeJob()

    async def aclose(self):
        self.closed = True


def test_api_lifecycle_and_job_submission(monkeypatch):
    redis = FakeRedis()

    async def fake_new_pool():
        return redis

    monkeypatch.setattr(api, "new_pool", fake_new_pool)

    with TestClient(api.app) as client:
        assert client.get("/health").json() == {"status": "ok"}
        assert client.get("/messages/count").json() == {"count": 0}
        response = client.post("/jobs", json={"message": "queued hello"})
        assert response.status_code == 202
        assert response.json() == {"job_id": "fake-job-001"}
        assert client.post("/jobs", json={"message": ""}).status_code == 422
        assert redis.messages == [("save_message", "queued hello")]

    assert redis.closed


def test_queue_rejection_is_reported(monkeypatch):
    class RejectingRedis(FakeRedis):
        async def enqueue_job(self, name: str, message: str):
            return None

    async def fake_new_pool():
        return RejectingRedis()

    monkeypatch.setattr(api, "new_pool", fake_new_pool)
    with TestClient(api.app) as client:
        response = client.post("/jobs", json={"message": "not accepted"})
        assert response.status_code == 503
