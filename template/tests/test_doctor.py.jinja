"""Doctor must report actionable failures without changing application state."""

import json
import socket
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Thread

from {{ package_name }}.config import get_settings
from {{ package_name }}.db import init_db
from {{ package_name }}.doctor import api_checks, diagnose


def test_missing_database_is_not_created(monkeypatch):
    monkeypatch.setattr("{{ package_name }}.doctor.systemd_checks", lambda: [])
    path = get_settings().database_path
    report = diagnose()
    assert report.status == "fail"
    sqlite = next(item for item in report.checks if item.id == "sqlite")
    assert sqlite.status == "fail"
    assert sqlite.action
    assert not path.exists()


def test_invalid_configuration_is_safe_json(monkeypatch):
    monkeypatch.setenv("APP_PORT", "secret-invalid-value")
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "doctor"],
        capture_output=True,
        text=True,
        check=False,
        timeout=20,
    )
    assert result.returncode == 1, result.stderr
    assert "secret-invalid-value" not in result.stdout
    report = json.loads(result.stdout)
    assert report["schema_version"] == 1
    assert report["status"] == "fail"
    assert any(item["id"] == "config" and item["status"] == "fail" for item in report["checks"])


def test_running_endpoint_and_readiness(monkeypatch):
    status = [200]

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            assert self.path == "/health/ready"
            self.send_response(status[0])
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status":"ok"}')

    with ThreadingHTTPServer(("127.0.0.1", 0), Handler) as server:
        monkeypatch.setenv("APP_HOST", "127.0.0.1")
        monkeypatch.setenv("APP_PORT", str(server.server_port))
        get_settings.cache_clear()
        thread = Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            assert [item.status for item in api_checks(get_settings(), True)] == ["pass", "pass"]
            status[0] = 503
            assert [item.status for item in api_checks(get_settings(), True)] == ["pass", "fail"]
        finally:
            server.shutdown()
            thread.join()


def test_offline_endpoint(monkeypatch):
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        monkeypatch.setenv("APP_HOST", "127.0.0.1")
        monkeypatch.setenv("APP_PORT", str(sock.getsockname()[1]))
        get_settings.cache_clear()
        assert [item.status for item in api_checks(get_settings(), False)] == ["warn", "skip"]
        assert [item.status for item in api_checks(get_settings(), True)] == ["fail", "skip"]


def test_sqlite_initialized(monkeypatch):
    monkeypatch.setattr("{{ package_name }}.doctor.systemd_checks", lambda: [])
    init_db()
    report = diagnose()
    assert next(item for item in report.checks if item.id == "sqlite").status == "pass"
