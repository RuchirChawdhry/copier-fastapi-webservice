import json
import subprocess
import sys


def test_standard_and_application_logs_share_format():
    command = (
        "import logging; from loguru import logger; "
        "from {{ package_name }}.logging_config import configure_logging; "
        "configure_logging(); logging.getLogger('uvicorn.access').info('http'); "
        "logger.info('application')"
    )
    result = subprocess.run(
        [sys.executable, "-c", command], capture_output=True, text=True, check=True, timeout=10
    )
    records = [json.loads(line)["record"] for line in result.stderr.splitlines()]
    assert [record["message"] for record in records] == ["http", "application"]
    assert [record["level"]["name"] for record in records] == ["INFO", "INFO"]
