import json
import subprocess
import sys


def test_resources_command():
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "resources"],
        capture_output=True,
        text=True,
        check=True,
        timeout=10,
    )
    report = json.loads(result.stdout)
    assert report["cli_rss_bytes"] > 0
    assert report["system_memory_total_bytes"] >= report["system_memory_available_bytes"] > 0
    assert report["cpu_logical"] > 0
