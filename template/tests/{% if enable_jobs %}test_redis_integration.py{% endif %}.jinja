"""Real HTTP, Redis Streams, Taskiq worker and SQLite integration."""

import os
import shutil
import socket
import subprocess
import sys
import time
from contextlib import contextmanager

import httpx
import pytest
from redis import Redis
from redis.exceptions import RedisError


def unused_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


@contextmanager
def process(command, env, logfile):
    with logfile.open("w") as output:
        child = subprocess.Popen(command, env=env, stdout=output, stderr=subprocess.STDOUT)
        try:
            yield child
        finally:
            child.terminate()
            try:
                child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()


def wait_until(predicate, child, logfile):
    deadline = time.monotonic() + 25
    while time.monotonic() < deadline and child.poll() is None:
        try:
            if predicate():
                return
        except httpx.TransportError, RedisError:
            pass
        time.sleep(0.1)
    pytest.fail(f"Service not ready: {logfile.read_text()}")


def test_real_job_delivery(tmp_path):
    redis_server = shutil.which("redis-server")
    if redis_server is None:
        if os.getenv("REQUIRE_REDIS_INTEGRATION") == "1":
            pytest.fail("redis-server is required for integration validation")
        pytest.skip("Install redis-server to run integration tests")

    redis_port, api_port = unused_port(), unused_port()
    env = {
        **os.environ,
        "REDIS_URL": f"redis://127.0.0.1:{redis_port}/0",
        "DATABASE_PATH": str(tmp_path / "integration.sqlite3"),
        "APP_HOST": "127.0.0.1",
        "APP_PORT": str(api_port),
    }
    redis_log = tmp_path / "redis.log"
    worker_log = tmp_path / "worker.log"
    api_log = tmp_path / "api.log"
    command = [
        redis_server,
        "--bind",
        "127.0.0.1",
        "--port",
        str(redis_port),
        "--save",
        "",
        "--appendonly",
        "no",
    ]
    cli = [sys.executable, "-m", "{{ package_name }}"]
    with process(command, env, redis_log) as redis_process:
        with Redis.from_url(env["REDIS_URL"]) as redis:
            wait_until(redis.ping, redis_process, redis_log)
        with (
            process([*cli, "worker"], env, worker_log) as worker,
            process([*cli, "serve"], env, api_log) as api,
            httpx.Client(base_url=f"http://127.0.0.1:{api_port}", timeout=2) as client,
        ):
            wait_until(lambda: client.get("/health/ready").status_code == 200, api, api_log)
            response = client.post("/jobs", json={"message": "real job"})
            assert response.status_code == 202, response.text
            assert response.json()["job_id"]
            wait_until(
                lambda: client.get("/messages/count").json()["count"] == 1,
                worker,
                worker_log,
            )
