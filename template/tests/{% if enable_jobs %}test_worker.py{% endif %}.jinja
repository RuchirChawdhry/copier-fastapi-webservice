import asyncio

from {{ package_name }}.db import count_messages, init_db
from {{ package_name }}.jobs import save_message
from {{ package_name }}.queue import broker


def test_task_registered_and_persists():
    init_db()
    assert broker.find_task(save_message.task_name) is save_message
    assert asyncio.run(save_message.original_func("from worker")) == 1
    assert count_messages() == 1
