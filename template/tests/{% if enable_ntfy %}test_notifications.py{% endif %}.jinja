"""Verify ntfy's real HTTP request contract without an external service."""

import asyncio
import json
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from threading import Thread

import httpx2
import pytest
from pydantic import ValidationError

from {{ package_name }}.config import get_settings
from {{ package_name }}.notifications import notify


@pytest.fixture
def ntfy_endpoint(monkeypatch):
    received = []
    status = [200]

    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):
            body = self.rfile.read(int(self.headers["Content-Length"]))
            received.append((self.path, self.headers.get("Authorization"), json.loads(body)))
            self.send_response(status[0])
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"id":"test-id"}')

    with ThreadingHTTPServer(("127.0.0.1", 0), Handler) as server:
        monkeypatch.setenv("NTFY_URL", f"http://127.0.0.1:{server.server_port}")
        monkeypatch.setenv("NTFY_TOPIC", "private-test")
        monkeypatch.setenv("NTFY_TOKEN", "tk_test")
        get_settings.cache_clear()
        thread = Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            yield received, status
        finally:
            server.shutdown()
            thread.join()


def test_publish(ntfy_endpoint):
    received, _ = ntfy_endpoint
    message_id = asyncio.run(notify("done", title="Backup", priority=4, tags=["white_check_mark"]))
    assert message_id == "test-id"
    assert received == [
        (
            "/",
            "Bearer tk_test",
            {
                "topic": "private-test",
                "message": "done",
                "title": "Backup",
                "priority": 4,
                "tags": ["white_check_mark"],
            },
        )
    ]
    assert "tk_test" not in repr(get_settings())


def test_publish_failure(ntfy_endpoint):
    received, status = ntfy_endpoint
    status[0] = 503
    with pytest.raises(httpx2.HTTPStatusError):
        asyncio.run(notify("failure"))
    assert len(received) == 1


def test_invalid_priority(ntfy_endpoint):
    received, _ = ntfy_endpoint
    with pytest.raises(ValidationError):
        asyncio.run(notify("invalid", priority=6))
    assert not received


def test_cli_publish(ntfy_endpoint):
    received, _ = ntfy_endpoint
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "notify", "CLI test"],
        capture_output=True,
        text=True,
        check=True,
        timeout=10,
    )
    assert "test-id" in result.stdout
    assert received[0][2]["message"] == "CLI test"


def test_unconfigured(monkeypatch, tmp_path):
    monkeypatch.chdir(tmp_path)
    monkeypatch.delenv("NTFY_URL", raising=False)
    monkeypatch.delenv("NTFY_TOPIC", raising=False)
    get_settings.cache_clear()
    with pytest.raises(ValueError, match="Configure NTFY_URL"):
        asyncio.run(notify("not sent"))
